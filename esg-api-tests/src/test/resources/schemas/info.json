{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Actuator info",
  "type": "object",
  "required": [
    "app"
  ],
  "properties": {
    "app": {
      "type": "object",
      "required": [
        "name",
        "environment",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
