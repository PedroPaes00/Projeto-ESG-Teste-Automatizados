{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Resposta de erro padronizada (ApiErrorResponse)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "status",
    "error",
    "message",
    "validations"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?$"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "validations": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
