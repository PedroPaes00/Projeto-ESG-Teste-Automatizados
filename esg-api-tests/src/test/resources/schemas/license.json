{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Licenca ambiental",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "code",
    "companyName",
    "licenseType",
    "status",
    "issuedAt",
    "expiresAt",
    "responsibleEmail",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "companyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "licenseType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "EXPIRING_SOON",
        "EXPIRED",
        "SUSPENDED"
      ]
    },
    "issuedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "responsibleEmail": {
      "type": "string",
      "minLength": 3,
      "maxLength": 150,
      "pattern": "^[^@\\s]+@[^@\\s]+$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?$"
    }
  }
}
